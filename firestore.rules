rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public can browse the menu/team; only an authenticated admin edits them.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public can request an appointment but never read the list (phone
    // numbers, other clients' bookings). Must always come in as 'pending' —
    // only an authenticated admin can confirm/cancel/complete or read back.
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }

    // Public can submit a review but it must start unapproved; only
    // approved reviews are publicly visible. Moderation is admin-only.
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || request.auth != null;
      allow create: if request.resource.data.approved == false;
      allow update, delete: if request.auth != null;
    }
  }
}
